#   case " $AUTHORS " in
#     *" $author "*) ;;
#     *) deny "docs/wiki/ を更新できるのは ingest 担当者のみです" \
#             "資料は docs/raw/ に置き、取り込みは担当者に依頼してください。" \
#             "担当者: $AUTHORS" ;;
#   esac
# fi

exit 0
