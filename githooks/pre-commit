#!/bin/bash
# 秘密情報の混入をコミット前に止める（Git クライアント側フック）。
#
# 有効化（クローン後に1回だけ）:
#   git config core.hooksPath .githooks      # 接続先プロジェクト
#   git config core.hooksPath githooks       # このリポジトリ（配布元）
#
# 検出パターンは secret-patterns.txt に定義する。SVN 側の svnhooks/pre-commit と
# 同じ定義を共有するため、このスクリプトにパターンを直接書かないこと。
#
# gitleaks があればそれを使い、無ければ内蔵のパターン検査にフォールバックする。
# 誤検知でどうしても通したいときは git commit --no-verify。
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 配置後（.githooks/ に複製された状態）と、このリポジトリ内の両方に対応する
for c in "$HERE/secret-patterns.txt" "$HERE/../lib/secret-patterns.txt"; do
  [ -f "$c" ] && PATTERNS="$c" && break
done

fail() {
  echo ""
  echo "  コミットを中止しました: $1"
  echo ""
  echo "  対処:"
  echo "    1. 該当箇所を削除するか、値を <REDACTED> などに置き換える"
  echo "    2. 実際に漏れた鍵は必ず再発行する（履歴からは消えない）"
  echo "    3. 誤検知なら  git commit --no-verify"
  echo ""
  exit 1
}

# --- 1. .env 系ファイルそのものの混入 -----------------------------------
staged=$(git diff --cached --name-only --diff-filter=ACM)

if echo "$staged" | grep -qE '(^|/)\.env($|\.)' && ! echo "$staged" | grep -qE '(^|/)\.env\.example$'; then
  echo "  検出: .env ファイルがステージされています"
  fail ".env は追跡しない"
fi

# --- 2. gitleaks があれば委譲 -------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner; then
    fail "gitleaks が秘密情報を検出"
  fi
  exit 0
fi

# --- 3. フォールバック: ステージ内容のパターン検査 ----------------------
if [ -z "${PATTERNS:-}" ]; then
  echo "  警告: secret-patterns.txt が見つからないため検査をスキップしました" >&2
  exit 0
fi

# 追加行（+ で始まる行）だけを見る。既存行の再検出を避けるため。
added=$(git diff --cached --unified=0 --diff-filter=ACM | grep '^+' | grep -v '^+++' || true)
[ -n "$added" ] || exit 0

# `!` 行を除外パターンとして 1本の ERE にまとめる
allow=$(grep '^!' "$PATTERNS" | sed 's/^!//' | paste -sd '|' -)

hits=""
while IFS= read -r p; do
  case "$p" in ''|'#'*|'!'*) continue ;; esac
  # -e で渡す。`-----BEGIN ...` のようにハイフンで始まるパターンを
  # grep がオプションと誤認するのを防ぐため。
  m=$(echo "$added" | grep -nEi -e "$p" || true)
  [ -n "$m" ] && [ -n "$allow" ] && m=$(echo "$m" | grep -vEi -e "$allow" || true)
  [ -n "$m" ] && hits="${hits}${m}"$'\n'
done < "$PATTERNS"

if [ -n "$hits" ]; then
  echo "  検出: 秘密情報らしき文字列（値の一部のみ表示）"
  echo "$hits" | sed 's/\(.\{100\}\).*/\1…/' | sed 's/^/    /' | head -10
  fail "秘密情報らしき文字列"
fi

exit 0
